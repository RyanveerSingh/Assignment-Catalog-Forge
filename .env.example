# Copy to .env.local for local development. Never commit .env.local.

# --- Database (Postgres 16+). Local: docker compose up -d postgres ---
DATABASE_URL=postgres://catalogforge:catalogforge@localhost:5432/catalogforge
# Optional pooled URL (Neon "pooled" connection string). Falls back to DATABASE_URL.
DATABASE_POOL_URL=

# --- AI provider ---
# anthropic | mock   (mock = deterministic demo mode, no key needed)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Model routing tiers (defaults shown)
AI_MODEL_CHEAP=claude-haiku-5-5
AI_MODEL_STRONG=claude-sonnet-5-5
AI_MODEL_ESCALATION=claude-opus-5-5
# Per-import spend cap in USD cents (default $5)
AI_IMPORT_BUDGET_CENTS=500

# --- Worker ---
# embedded = run the job loop inside the Next.js process (free-tier deployment)
# separate = run `npm run worker` as its own process (local docker-compose, paid hosts)
# none     = this process never runs jobs
WORKER_MODE=embedded
WORKER_CONCURRENCY=4
AI_CONCURRENCY=4

# --- Storage for uploaded sheets and photos ---
# pg (blobs in Postgres) | local (./.data) | s3 (S3-compatible, needs the S3_* vars)
STORAGE_DRIVER=pg
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- App ---
APP_SECRET=change-me-to-a-random-string-of-at-least-32-chars
APP_BASE_URL=http://localhost:3000
LOG_LEVEL=info

# --- Limits (free-tier defaults) ---
MAX_ROWS_PER_IMPORT=10000
MAX_PHOTOS_PER_IMPORT=2000
MAX_SHEET_BYTES=52428800
MAX_PHOTO_BYTES=26214400
MAX_ZIP_BYTES=209715200

# --- Chaos (admin testing only; all default off) ---
CHAOS_RATE_LIMIT_PCT=0
CHAOS_TIMEOUT_PCT=0
CHAOS_INVALID_JSON_PCT=0
