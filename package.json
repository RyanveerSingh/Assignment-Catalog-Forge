{
  "name": "catalogforge",
  "version": "0.1.0",
  "private": true,
  "description": "AI product catalog builder: messy supplier sheets and photos in, clean multi-language storefront catalog out.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:worker": "tsx watch src/worker/main.ts",
    "build": "next build",
    "start": "next start",
    "worker": "tsx src/worker/main.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "seed": "tsx scripts/seed.ts",
    "samples": "tsx scripts/generate-samples.ts",
    "eval": "tsx eval/run.ts",
    "load": "tsx scripts/load-test.ts",
    "tunnel": "tsx scripts/tunnel.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.1.0",
    "@base-ui/react": "^1.9.0",
    "@tanstack/react-table": "^8.21.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "franc": "^6.2.0",
    "iconv-lite": "^0.7.3",
    "jschardet": "^4.0.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "papaparse": "^5.7.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-dropzone": "^20.1.4",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "tw-animate-css": "^1.4.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yauzl": "^3.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/autocannon": "^7.12.7",
    "@types/node": "^22",
    "@types/papaparse": "^5.3.16",
    "@types/pg": "^8.15.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/sanitize-html": "^2.16.0",
    "@types/yauzl": "^3.4.0",
    "@types/yazl": "^3.3.1",
    "autocannon": "^8.0.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "15.5.28",
    "shadcn": "^4.22.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5",
    "yazl": "^3.3.1"
  }
}
